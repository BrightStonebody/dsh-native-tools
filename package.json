{
  "name": "dsh-native-tools",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Harness 的原生助手四合一：截图（拖框、工具条、红框标注、文字识别）、剪贴板历史、划词翻译、系统监控（菜单栏网络/CPU/内存三个图标 + 点看进程排名）。四个功能跑在同一个 AppKit 进程里，各自可在插件页单独开关。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "translate-host.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "helper",
    "install.sh",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "author": "BrightStonebody",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrightStonebody/dsh-native-tools.git"
  },
  "homepage": "https://github.com/BrightStonebody/dsh-native-tools#readme",
  "bugs": {
    "url": "https://github.com/BrightStonebody/dsh-native-tools/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "clipboard",
    "translate",
    "macos",
    "ocr",
    "appkit",
    "monitor",
    "menubar",
    "system-monitor"
  ]
}
